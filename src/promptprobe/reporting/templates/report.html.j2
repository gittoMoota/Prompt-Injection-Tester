<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Prompt Injection Test Report</title>
<style>
  :root { --bg:#ffffff; --fg:#1f2328; --muted:#59636e; --line:#d1d9e0; --bad:#b42318; --good:#067647; --warn:#b54708; }
  @media (prefers-color-scheme: dark) {
    :root { --bg:#0d1117; --fg:#e6edf3; --muted:#9198a1; --line:#30363d; --bad:#f97066; --good:#47cd89; --warn:#fdb022; }
  }
  body { font-family: system-ui, sans-serif; background: var(--bg); color: var(--fg); margin: 0; padding: 1.5rem; line-height: 1.5; }
  main { max-width: 960px; margin: 0 auto; }
  .cards { display: flex; flex-wrap: wrap; gap: .75rem; margin: 1rem 0 1.5rem; }
  .card { border: 1px solid var(--line); border-radius: 8px; padding: .75rem 1rem; min-width: 7rem; }
  .card b { display: block; font-size: 1.5rem; }
  table { border-collapse: collapse; width: 100%; margin-bottom: 1.5rem; }
  th, td { text-align: left; padding: .5rem; border-bottom: 1px solid var(--line); vertical-align: top; }
  .scroll { overflow-x: auto; }
  .leaked { color: var(--bad); font-weight: 600; }
  .passed { color: var(--good); font-weight: 600; }
  .error { color: var(--warn); font-weight: 600; }
  pre { white-space: pre-wrap; word-break: break-word; margin: .25rem 0 0; }
  .muted { color: var(--muted); }
</style>
</head>
<body>
<main>
  <h1>Prompt Injection Test Report</h1>
  <p class="muted">Target: {{ summary.target_url }} &middot; Run: {{ summary.created_at }}</p>

  <div class="cards">
    <div class="card"><b>{{ summary.total }}</b>Attacks</div>
    <div class="card"><b class="leaked">{{ summary.leaked }}</b>Leaked</div>
    <div class="card"><b class="passed">{{ summary.passed }}</b>Passed</div>
    <div class="card"><b class="error">{{ summary.errors }}</b>Errors</div>
    <div class="card"><b>{{ "%.0f"|format(summary.pass_rate * 100) }}%</b>Pass rate</div>
  </div>

  <h2>Results by category</h2>
  <div class="scroll">
  <table>
    <thead><tr><th>Category</th><th>Leaked</th><th>Passed</th><th>Errors</th><th>Total</th></tr></thead>
    <tbody>
    {% for name, s in summary.by_category.items() %}
      <tr><td>{{ name }}</td><td>{{ s.leaked }}</td><td>{{ s.passed }}</td><td>{{ s.errors }}</td><td>{{ s.total }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>

  <h2>All attacks</h2>
  <div class="scroll">
  <table>
    <thead><tr><th>ID</th><th>Category</th><th>Severity</th><th>Status</th><th>Details</th></tr></thead>
    <tbody>
    {% for r in rows %}
      <tr>
        <td>{{ r.id }}</td>
        <td>{{ r.category }}</td>
        <td>{{ r.severity }}</td>
        <td class="{{ r.status }}">{{ r.status|upper }}</td>
        <td>
          <details>
            <summary>{{ r.evidence or r.error or "No leak detected" }}</summary>
            <p><b>Attack</b></p>
            <pre>{{ r.prompt }}</pre>
            <p><b>Reply</b></p>
            <pre>{{ r.response }}</pre>
            <p class="muted">{{ r.latency_ms }} ms</p>
          </details>
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
</main>
</body>
</html>